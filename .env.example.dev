NODE_ENV="development"
# Comma-separated GitHub usernames allowed to trigger reviews and rate feedback.
DEV_GITHUB_USER_ALLOWLIST="your-github-username"
GITHUB_MEMBERSHIP_ORG="CodeYourFuture"
APP_ID="YOUR_APP_ID"
WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"
GITHUB_PRIVATE_KEY_PATH="YOUR_PATH_TO_PRIVATE_GITHUB_KEY"
WEBHOOK_PROXY_URL="YOUR_WEBHOOK_PROXY_URL"
OPENROUTER_API_KEY="YOUR_KEY"
AI_MODEL="openai/gpt-6-luna"
AI_REASONING_EFFORT="medium"
AI_MAX_COMPLETION_TOKENS=25000
MULTIPLE_REVIEWS_ALLOWED=true
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_URL="postgres://user:password@localhost:5432/your_db"
GITHUB_APP_CLIENT_ID="YOUR_GITHUB_APP_CLIENT_ID"
GITHUB_APP_CLIENT_SECRET="YOUR_GITHUB_APP_CLIENT_SECRET"
GITHUB_OAUTH_CALLBACK_URL="http://localhost:3000/api/auth/callback"
# Generate a random secret with at least 32 characters; keep it backend-only.
SESSION_SECRET_KEY=""
SESSION_EXPIRE_HOURS=24
FRONTEND_BASE_URL="http://localhost:5173"
